<div class="container" style="margin-top: 50px;">
    <div class="container" style="margin-top: 50px;">
        <h2>Listado de Novedades (CRUD Novedades)</h2>

        {{#if programador}}
            <h4 class="mt-4">Editar novedad</h4>
            <form action="/admin/novedades/editar/{{programador.id}}" method="post" class="mb-4">
                <div class="row">
                    <div class="col">
                        <input type="text" class="form-control" value="{{programador.titulo}}" name="titulo" required>
                    </div>
                    <div class="col">
                        <input type="text" class="form-control" value="{{programador.subtitulo}}" name="subtitulo" required>
                    </div>
                    <div class="col">
                        <input type="text" class="form-control" value="{{programador.cuerpo}}" name="cuerpo" required>
                    </div>
                    <div class="col-auto d-flex gap-2">
                        <button type="submit" class="btn btn-success">Guardar cambios</button>
                        <a href="/admin/novedades" class="btn btn-secondary">Cancelar</a>
                    </div>
                </div>
            </form>
        {{else}}
            <!-- Formulario Agregar Novedad -->
            <form action="/admin/novedades/agregar" method="post" class="mb-4">
                <div class="row">
                    <div class="col">
                        <input type="text" class="form-control" placeholder="Título" name="titulo" required>
                    </div>
                    <div class="col">
                        <input type="text" class="form-control" placeholder="Subtítulo" name="subtitulo" required>
                    </div>
                    <div class="col">
                        <input type="text" class="form-control" placeholder="Cuerpo" name="cuerpo" required>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary">Agregar</button>
                    </div>
                </div>
            </form>
        {{/if}}

        {{#if error}}
            <div class="alert alert-danger" role="alert">
                {{message}}
            </div>
        {{/if}}

        <!-- Tabla de Datos desde MySQL -->
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Título</th>
                    <th>Subtítulo</th>
                    <th>Cuerpo</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                {{#each programadores}}
                <tr>
                    <td>{{id}}</td>
                    <td>{{titulo}}</td>
                    <td>{{subtitulo}}</td>
                    <td>{{cuerpo}}</td>
                    <td class="text-end d-flex justify-content-end gap-2">
                        <a href="/admin/novedades/editar/{{id}}" class="btn btn-sm btn-warning">Editar</a>
                        <a href="/admin/novedades/eliminar/{{id}}" class="btn btn-sm btn-danger">Eliminar</a>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>

    <!-- Sección de usuario logueado en el sistema -->
    <div class="container" style="margin-top: 50px;">
        <div class="row mb-4">
            <div class="col text-end">
                <p>Hola {{usuario}}! <a class="btn btn-danger btn-sm" href="/admin/login/logout">Cerrar Sesión</a></p>
            </div>
        </div>
    </div>
</div>
